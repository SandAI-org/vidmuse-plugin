{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmuse.ai/schemas/vidmuse-recut/style-atom.schema.json",
  "title": "VidMuse Recut Style Atom",
  "type": "object",
  "required": ["id", "version", "status", "dimension", "name", "description", "use_when", "avoid"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["seed", "validated"]},
    "dimension": {
      "type": "string",
      "enum": ["editorial_stance", "visual_culture", "material", "typography", "composition", "color_logic", "motion_temperament", "source_relationship"]
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "use_when": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "avoid": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "compatible_with": {"type": "array", "items": {"type": "string"}},
    "conflicts_with": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
