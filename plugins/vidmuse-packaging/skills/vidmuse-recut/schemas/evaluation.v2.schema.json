{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmuse.ai/schemas/vidmuse-recut/evaluation.v2.schema.json",
  "title": "VidMuse Recut Director Evaluation",
  "type": "object",
  "required": ["schema", "project_id", "production_mode", "status", "renders", "review_passes", "findings", "correction_history", "stop_conditions", "feedback"],
  "properties": {
    "schema": {"const": "vidmuse.recut.evaluation.v2"},
    "project_id": {"type": "string", "minLength": 1},
    "production_mode": {"const": "director"},
    "status": {"enum": ["pending", "needs_revision", "ready", "approved", "rejected"]},
    "renders": {
      "type": "object",
      "required": ["hero_frames", "motion_reel", "act_renders", "full_draft", "final"],
      "properties": {
        "hero_frames": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scene_id", "path"],
            "properties": {"scene_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          }
        },
        "motion_reel": {"type": ["string", "null"]},
        "act_renders": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "full_draft": {"type": ["string", "null"]},
        "final": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "review_passes": {
      "type": "object",
      "required": ["hero_frame_passes", "motion_reel_passes", "act_review", "full_film_review", "reference_gap_review", "correction_review", "final_polish"],
      "properties": {
        "hero_frame_passes": {"type": "array", "items": {"$ref": "#/$defs/reviewPass"}},
        "motion_reel_passes": {"type": "array", "items": {"$ref": "#/$defs/reviewPass"}},
        "act_review": {"type": "array", "items": {"$ref": "#/$defs/reviewPass"}},
        "full_film_review": {"type": "array", "items": {"$ref": "#/$defs/reviewPass"}},
        "reference_gap_review": {"type": "array", "items": {"$ref": "#/$defs/reviewPass"}},
        "correction_review": {"type": "array", "items": {"$ref": "#/$defs/reviewPass"}},
        "final_polish": {"type": "array", "items": {"$ref": "#/$defs/reviewPass"}}
      },
      "additionalProperties": false
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "correction_history": {"type": "array", "items": {"$ref": "#/$defs/correction"}},
    "stop_conditions": {
      "type": "object",
      "required": ["opening_promise", "major_claim_visual_proof", "energy_variation", "signature_sequence", "act_world_coherence", "source_motion_sound_integration", "hero_frames", "motion_handoffs", "technical_integrity", "dialogue_and_sound", "official_reference_gap"],
      "properties": {
        "opening_promise": {"$ref": "#/$defs/stop"},
        "major_claim_visual_proof": {"$ref": "#/$defs/stop"},
        "energy_variation": {"$ref": "#/$defs/stop"},
        "signature_sequence": {"$ref": "#/$defs/stop"},
        "act_world_coherence": {"$ref": "#/$defs/stop"},
        "source_motion_sound_integration": {"$ref": "#/$defs/stop"},
        "hero_frames": {"$ref": "#/$defs/stop"},
        "motion_handoffs": {"$ref": "#/$defs/stop"},
        "technical_integrity": {"$ref": "#/$defs/stop"},
        "dialogue_and_sound": {"$ref": "#/$defs/stop"},
        "official_reference_gap": {"$ref": "#/$defs/stop"}
      },
      "additionalProperties": false
    },
    "feedback": {"type": "object"}
  },
  "$defs": {
    "stop": {"enum": ["pending", "pass", "fail"]},
    "reviewPass": {
      "type": "object",
      "required": ["id", "status", "evidence", "findings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "pass", "fail"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "status", "target", "note", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "major", "minor"]},
        "status": {"enum": ["open", "resolved", "waived"]},
        "target": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "waiver_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "required": ["id", "finding_ids", "action", "before", "after", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "action": {"type": "string", "minLength": 1},
        "before": {},
        "after": {},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
