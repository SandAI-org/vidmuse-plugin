{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmuse.ai/schemas/vidmuse-recut/style-pack.schema.json",
  "title": "VidMuse Recut Official Style Pack",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "kind",
    "name",
    "tagline",
    "source",
    "anchor_atoms",
    "default_motion",
    "effect_affinity",
    "suitable_for",
    "avoid_for",
    "recut_fit",
    "adopt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^pack:[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "const": "official" },
    "kind": { "const": "style-pack" },
    "name": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["origin", "local_path", "frame_md"],
      "properties": {
        "origin": { "type": "string" },
        "preset_dir": { "type": "string" },
        "local_path": { "type": "string" },
        "frame_md": { "type": "string" },
        "caption_skin": { "type": "string" },
        "showcase": { "type": "string" }
      },
      "additionalProperties": true
    },
    "look": { "type": "object" },
    "palette_preview": { "type": "object" },
    "anchor_atoms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "default_motion": {
      "type": "object",
      "required": ["dur_fast", "dur_base", "dur_slow", "ease_enter", "ease_exit"],
      "additionalProperties": true
    },
    "effect_affinity": {
      "type": "object",
      "required": ["prefer"],
      "properties": {
        "prefer": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "weight_bias": { "type": "string" }
      },
      "additionalProperties": false
    },
    "suitable_for": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "avoid_for": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "recut_fit": { "type": "string", "enum": ["strong", "medium", "weak"] },
    "adopt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
