{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmuse.ai/schemas/vidmuse-recut/style-profile.schema.json",
  "title": "VidMuse Recut Reference Style Profile",
  "type": "object",
  "required": ["id", "version", "status", "name", "description", "anchor_atoms", "suitable_for", "avoid_for", "principles", "avoid", "signature_seeds", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "reference"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "anchor_atoms": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 8, "maxItems": 8, "uniqueItems": true},
    "suitable_for": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "avoid_for": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "principles": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "avoid": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "signature_seeds": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "provenance": {
      "type": "object",
      "required": ["source", "review"],
      "properties": {"source": {"type": "string"}, "review": {"const": "reference-only"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
