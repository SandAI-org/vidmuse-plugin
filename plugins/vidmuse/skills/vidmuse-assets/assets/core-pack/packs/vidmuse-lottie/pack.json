{
  "schema": "vidmuse.core-pack.pack.v1",
  "id": "vidmuse-lottie",
  "type": "lottie",
  "title": "VidMuse state animations",
  "description": "Original Lottie state animations for agent/product films: spinner, progress ring, success check, error cross, and pulse marker. Authored as plain Lottie JSON (no After Effects), single full cycle, no loop baked in.",
  "upstream": {
    "self": true,
    "note": "Authored for VidMuse as hand-written Lottie JSON. Not exported from, traced from, or derived from any third-party Lottie library, LottieFiles asset, or icon animation pack."
  },
  "license": {
    "spdx": "CC0-1.0",
    "receipt": "LICENSE.txt",
    "redistributable": true,
    "commercial_output": true,
    "attribution_required": false,
    "copyright": "VidMuse"
  },
  "verified": {
    "player": "lottie-web@5.12.2",
    "method": "loadAnimation({renderer:'svg',autoplay:false,loop:false}) then goToAndStop() at 5%, 50%, and 95% of totalFrames",
    "asserts": "each file parses, seeks without throwing, draws shapes, and renders different geometry across the three seeks",
    "note": "Structural JSON validity is not enough — a malformed keyframe or a shape that never moves would still parse. These were checked against the player that HyperFrames actually seeks."
  },
  "tags": [
    "state",
    "ui",
    "feedback",
    "animation"
  ],
