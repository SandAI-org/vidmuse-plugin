{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmuse.ai/schemas/vidmuse-recut/effect-sources.schema.json",
  "title": "VidMuse Recut Effect Sources",
  "type": "object",
  "required": ["schema", "hyperframes_version", "effects"],
  "properties": {
    "schema": {"const": "vidmuse.recut.effect-sources.v1"},
    "hyperframes_version": {"type": "string", "minLength": 1},
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "type", "integration_mode", "adaptations", "cdn_urls"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "enum": ["hyperframes-registry", "vidmuse-native"]},
          "type": {"type": "string", "enum": ["block", "component", "native"]},
          "integration_mode": {"type": "string"},
          "upstream_version": {"type": ["string", "null"]},
          "adaptations": {"type": "array", "items": {"type": "string"}},
          "cdn_urls": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
