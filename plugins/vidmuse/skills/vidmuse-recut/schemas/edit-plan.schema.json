{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmuse.ai/schemas/vidmuse-recut/edit-plan.schema.json",
  "title": "VidMuse Recut Edit Plan",
  "type": "object",
  "required": ["schema", "project_id", "timeline", "slots"],
  "properties": {
    "schema": {"const": "vidmuse.recut.edit-plan.v2"},
    "project_id": {"type": "string", "minLength": 1},
    "timeline": {
      "type": "object",
      "required": ["duration_seconds", "timebase"],
      "properties": {
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "timebase": {"const": "output_seconds"}
      },
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "intent", "pattern", "effect", "content", "priority", "zone", "constraints"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "intent": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1},
          "effect": {
            "type": "object",
            "required": ["id", "source", "weight", "integration_mode"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "enum": ["hyperframes-registry", "vidmuse-native"]},
              "weight": {"type": "string", "enum": ["bare-text", "emphasis", "line-mark", "camera", "diagram", "panel-card", "grammar"]},
              "integration_mode": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "content": {"type": "object"},
          "priority": {"type": "string", "enum": ["primary", "secondary", "support"]},
          "zone": {"type": "string", "enum": ["fullscreen", "whiteboard-area", "lower-third", "side-panel", "video-overlay"]},
          "accentIndex": {"type": "integer", "minimum": 0},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "override": {"type": ["object", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
